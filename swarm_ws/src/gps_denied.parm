# GPS-denied setup: the EKF takes position and yaw from VISION_POSITION_ESTIMATE
# (sent by drone_mapping/vio_to_ardupilot) instead of GPS.
#
# ArduPilot 4.6 renamed GPS_TYPE -> GPS1_TYPE and SIM_GPS_TYPE -> SIM_GPS1_TYPE.
# Both spellings are listed so the file works either way; the autopilot ignores
# the names it does not know. If the simulated GPS is left enabled, arming fails
# with "PreArm: GPS and AHRS differ by <n>m".
GPS_TYPE 0
GPS_TYPE2 0
GPS1_TYPE 0
GPS2_TYPE 0
SIM_GPS_TYPE 0
SIM_GPS2_TYPE 0
SIM_GPS1_TYPE 0
SIM_GPS2_TYPE 0
AHRS_EKF_TYPE 3
# Source set 1: position/velocity/yaw from external nav (6), height from baro (1).
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 6
# The pre-arm check walks *every* source set, and sets 2 and 3 default to GPS,
# which fails as "AHRS: EK3 sources require GPS". Blank them out.
EK3_SRC2_POSXY 0
EK3_SRC2_VELXY 0
EK3_SRC2_POSZ 1
EK3_SRC2_VELZ 0
EK3_SRC2_YAW 0
EK3_SRC3_POSXY 0
EK3_SRC3_VELXY 0
EK3_SRC3_POSZ 1
EK3_SRC3_VELZ 0
EK3_SRC3_YAW 0
FRAME_CLASS 1
FRAME_TYPE 1
VISO_TYPE 1
