Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /Survivors1
        - /Hazards1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 60; 64; 58
      Alpha: 0.35
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 1
      Draw Behind: true

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color: 82; 192; 168
      Color Transformer: FlatColor
      Alpha: 1
      Decay Time: 0

    - Class: rviz_default_plugins/MarkerArray
      Name: Survivors
      Enabled: true
      Topic:
        Value: /person_map_pins
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Namespaces: {}

    - Class: rviz_default_plugins/MarkerArray
      Name: Hazards
      Enabled: true
      Topic:
        Value: /hazard_markers
        Depth: 20
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Namespaces: {}

    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /exploration/planned_path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 239; 165; 68
      Line Style: Lines
      Alpha: 1

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Marker Scale: 1

  Global Options:
    Background Color: 23; 26; 24
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top down
      Target Frame: map
      Scale: 22
      X: 0
      Y: 0
      Angle: 0
      Invert Z Axis: false
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1500
  QMainWindow State: ""
