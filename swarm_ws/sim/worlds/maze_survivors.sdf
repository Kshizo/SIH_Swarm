      <pose>9.600 -9.600 0 0 0 -1.106</pose>
      <static>true</static>
    </include>

    <!-- survivor 2 at maze cell (5, 5) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy</uri>
      <name>survivor_2</name>
      <pose>0.000 0.000 0 0 0 -2.193</pose>
      <static>true</static>
    </include>

    <!-- survivor 3 at maze cell (5, 1) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy</uri>
      <name>survivor_3</name>
      <pose>0.000 -9.600 0 0 0 0.948</pose>
      <static>true</static>
    </include>

    <!-- survivor 4 at maze cell (3, 7) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy</uri>
      <name>survivor_4</name>
      <pose>-4.800 4.800 0 0 0 -2.685</pose>
      <static>true</static>
    </include>

    <!-- debris 1: narrows the corridor at (9, 4) to 1.8 m -->
    <model name="debris_1">
      <static>true</static>
      <pose>10.500 -2.400 0.700 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.600 1.080 1.400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.600 1.080 1.400</size></box></geometry>
          <material>
            <ambient>0.28 0.24 0.20 1</ambient>
            <diffuse>0.46 0.40 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- debris 2: narrows the corridor at (6, 9) to 1.8 m -->
    <model name="debris_2">
      <static>true</static>
      <pose>2.400 10.500 0.700 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.080 0.600 1.400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.080 0.600 1.400</size></box></geometry>
          <material>
            <ambient>0.28 0.24 0.20 1</ambient>
            <diffuse>0.46 0.40 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- debris 3: narrows the corridor at (1, 8) to 1.8 m -->
    <model name="debris_3">
      <static>true</static>
      <pose>-8.700 7.200 0.700 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.600 1.080 1.400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.600 1.080 1.400</size></box></geometry>
          <material>
            <ambient>0.28 0.24 0.20 1</ambient>
            <diffuse>0.46 0.40 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fixed overhead camera, for recording the mission from outside.
         Looks straight down with image up = world +Y, image right = world +X. -->
    <model name="observer">
      <static>true</static>
      <pose>0 0 30.0 0 1.5707963 1.5707963</pose>
      <link name="link">
        <sensor name="observer_camera" type="camera">
          <topic>/observer/image</topic>
          <gz_frame_id>observer</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>0.9157</horizontal_fov>
            <image>
              <width>720</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.5</near><far>200.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://iris_with_sensors</uri>
      <name>drone1</name>
      <pose>-9.600 -9.600 0.195 0 0 0.000</pose>
    </include>

    <include>
      <uri>model://iris_with_sensors_2</uri>
      <name>drone2</name>
      <pose>9.600 9.600 0.195 0 0 3.142</pose>
    </include>

  </world>
</sdf>
